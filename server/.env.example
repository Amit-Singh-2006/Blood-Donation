# ── Backend (Express, run from server/) ─────────────────────────────
# Copy to server/.env. Set the same variables on the Vercel backend project.
PORT=5000

# Postgres. Supabase: project > Connect > "Transaction pooler" URI (port 6543),
# with your database password filled in. Tables are created on first start.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-1-your-region.pooler.supabase.com:6543/postgres"

# Signs login tokens. Keep it long and random; changing it logs everyone out.
JWT_SECRET="your-jwt-secret"

# AI chat (/ai/chat). Server-side only; never prefix it with VITE_.
GROQ_API_KEY="your-groq-api-key"

# ── Donor network messages ─────────────────────────────────────────
# The donor network runs inside this API. Alerts always appear in the app;
# each channel below is used once its settings are present (missing ones are
# skipped, and the admin dashboard's Settings tab shows which are set up).

# SMS through Twilio (console.twilio.com > Account info). TWILIO_FROM is your
# Twilio number, or a Messaging Service SID (MG...).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+18167938450

# WhatsApp through Meta's Cloud API (developers.facebook.com > your app >
# WhatsApp > API Setup). Use a permanent System User token: the temporary one
# expires within a day. Blood requests use the approved template
# lifelink_blood_request (4 values: blood group, hospital, YES link, NO link).
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ALERT_TEMPLATE=lifelink_blood_request|en
# WHATSAPP_API_VERSION=v23.0

# Email (password reset codes, campaign invitations) over SMTP. With Gmail,
# turn on 2-Step Verification, then create an app password at
# https://myaccount.google.com/apppasswords
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# EMAIL_FROM="LifeLink <you@gmail.com>"

# USSD for basic phones: a secret you add to the gateway's callback URL, e.g.
# https://<api>/network/ussd?key=<this value>. USSD stays off without it.
# USSD_GATEWAY_KEY=

# Address of this API in the links LifeLink sends (defaults to production)
# API_PUBLIC_URL=http://localhost:5000

# Optional
# FRONTEND_URL=         extra allowed frontend origins, comma-separated; the first
#                       https one is the website address in links (certificates, replies)
# ADMIN_INVITE_CODE=    needed once: the first (national) admin signs up with it while
#                       no admin exists; every later admin gets a personal invite

# Rate limits that guard sign-in, codes, uploads and certificate checks count in
# Postgres on Vercel and Cloud Run, so every server instance shares them.
# Elsewhere they are kept in memory unless this is set.
# RATE_LIMIT_STORE=postgres

# Deployed API only (Cloud Run): where the database timer sends its ticks, e.g.
# https://lifelink-api-123456789.asia-south1.run.app/network/tick. Never set it on
# a PC that uses the live database, or the timer would call that PC.
# NETWORK_TICK_URL=

# ── Database backups (npm run backup, on a PC; not used on Vercel) ───────
# Where the encrypted backups go. Default: OneDrive\LifeLink backups, else ~/lifelink-backups
# LIFELINK_BACKUP_DIR=
# The key file, created by the first backup. Default: ~/lifelink-private/backup-key.txt
# Keep a copy in a password manager: without the key no backup can be opened.
# LIFELINK_BACKUP_KEY_FILE=
# How many backups to keep (default 30)
# LIFELINK_BACKUP_KEEP=30
# Disaster recovery only (npm run restore-backup -- restore <file>): the EMPTY database to fill
# RESTORE_DATABASE_URL=
