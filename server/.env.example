# ── Backend (Express, run from server/) ─────────────────────────────
# Copy to server/.env. Set the same variables on the Vercel backend project.
PORT=5000

# Postgres. Supabase: project > Connect > "Transaction pooler" URI (port 6543),
# with your database password filled in. Tables are created on first start.
DATABASE_URL="postgresql://postgres.your-project-ref:your-password@aws-1-your-region.pooler.supabase.com:6543/postgres"

# Signs login tokens. Keep it long and random; changing it logs everyone out.
JWT_SECRET="your-jwt-secret"

# AI chat (/ai/chat). Server-side only; never prefix it with VITE_.
GROQ_API_KEY="your-groq-api-key"

# n8n donor network: the same value as the n8n "Header Auth account" credential.
N8N_WEBHOOK_KEY="your-x-lifelink-key"

# Optional
# N8N_WEBHOOK_BASE=https://amitsingh7291.app.n8n.cloud/webhook/lifelink
# FRONTEND_URL=         extra allowed frontend origins, comma-separated
# ADMIN_INVITE_CODE=    needed once, to register the single admin account
