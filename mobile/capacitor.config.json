{
  "appId": "com.lifelink.blooddonation",
  "appName": "LifeLink",
  "webDir": "www",
  "backgroundColor": "#ffffff",
  "appendUserAgent": "LifeLinkApp",
  "server": {
    "url": "https://blood-donation-frontend-delta.vercel.app",
    "androidScheme": "https",
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "style": "LIGHT"
    },
    "SplashScreen": {
      "launchShowDuration": 1500,
      "launchAutoHide": true,
      "backgroundColor": "#ffffff",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP"
    }
  }
}
