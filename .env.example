# ── Frontend (Vite) ─────────────────────────────────────────────────
# Copy to .env. Only VITE_* variables reach the browser bundle, so never put
# secrets here. Backend secrets live in server/.env (see server/.env.example).

# Backend API the frontend calls. Local dev: the Express server in server/.
VITE_API_BASE_URL=http://127.0.0.1:5000

# Firebase web config (public by design; access is enforced by Firebase rules)
VITE_FIREBASE_API_KEY="your-firebase-key"
VITE_FIREBASE_AUTH_DOMAIN="your-firebase-domain"
VITE_FIREBASE_PROJECT_ID="your-firebase-project"
VITE_FIREBASE_STORAGE_BUCKET="your-firebase-bucket"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Google Apps Script web apps (community sign-ups, donation certificates)
VITE_GOOGLE_SCRIPT_URL="your-google-script-url"
VITE_GOOGLE_SCRIPT_CERTIFICATE_URL="your-certificate-script-url"
