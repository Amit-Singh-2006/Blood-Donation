# ── Frontend (Vite) ─────────────────────────────────────────────────
# Copy to .env. Only VITE_* variables reach the browser bundle, so never put
# secrets here. Backend secrets live in server/.env (see server/.env.example).

# Backend API the frontend calls. Local dev: the Express server in server/.
VITE_API_BASE_URL=http://localhost:5000

# Contact inbox shown on Support, Privacy and Terms. Leave empty to hide email
# contact (never point it at a domain you don't own).
VITE_CONTACT_EMAIL=""
# Grievance Officer named on the Terms and Privacy Policy (IT Rules, 2021)
VITE_GRIEVANCE_OFFICER_NAME=""
